# ==============================================================================
# MedGuard AI — Environment Configuration Template (.env.example)
# Team Vouken · 2026
#
# INSTRUCTIONS:
# Copy this file to .env for local overrides, or configure these variables
# in the Vercel Dashboard under Project Settings -> Environment Variables.
# DO NOT COMMIT PRIVATE KEYS OR SENSITIVE DATA.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Runtime & Execution Mode
# ------------------------------------------------------------------------------
# Set to 'real' for PyTorch ResNet-18 model inference and validation.
# Set to 'demo' for synthetic educational fixtures (UI verification without PyTorch).
MEDGUARD_MODE=real

# Maximum inference timeout in seconds before aborting slow requests
INFERENCE_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 2. Vercel Fluid Compute & Serverless Engine Settings (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Enables Vercel Large Functions support (up to 5 GB uncompressed bundle size)
# Required for PyTorch, TorchVision, and scientific dependencies on Vercel.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Set to 1 in Vercel to output detailed uncompressed bundle size breakdown during builds
VERCEL_ANALYZE_BUILD_OUTPUT=1

# ------------------------------------------------------------------------------
# 3. Security & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. In Vercel Services, /api is same-origin,
# but preview domains are supported via regex (*.vercel.app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://*.vercel.app

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Leave empty for same-origin '/api' routing (recommended in production and local Vite proxy).
# Set to full URL (e.g. https://api.yourdomain.com) only if deploying backend to a separate domain.
VITE_API_BASE=

# ------------------------------------------------------------------------------
# 5. Storage & Writable Directories
# ------------------------------------------------------------------------------
# Directory for temporary Grad-CAM heatmap generation.
# On Vercel / AWS Lambda, automatically defaults to /tmp/medguard_heatmaps.
# MEDGUARD_HEATMAPS_DIR=/tmp/medguard_heatmaps
